APP_ENV=development
PORT=3030
PUBLIC_BASE_URL=http://localhost:3030
MEDIA_ROOT=./data/media
APP_TIMEZONE=Asia/Jakarta

# Postgres. Di produksi pakai password acak >= 32 karakter: openssl rand -hex 24
POSTGRES_USER=sisaguna
POSTGRES_PASSWORD=ganti-dengan-password-acak
POSTGRES_DB=sisaguna
# Ganti kalau 5432 sudah dipakai Postgres lain di mesin Anda
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sisaguna:ganti-dengan-password-acak@localhost:5432/sisaguna?sslmode=disable

# Minimal 32 byte acak: openssl rand -base64 48
JWT_SECRET=

# Admin awal (dipakai seeder)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Admin SisaGuna"

# Cadangan Cloudflare R2 (bucket privat). Kosongkan di development. Kalau terisi: media disalin ke R2 tiap menit
# dan backup database harian dikirim ke R2. Kalau kosong di produksi, backup disimpan lokal di /srv/sisaguna/backups.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Hanya produksi (deploy/docker-compose.prod.yml)
DOMAIN=api.sisaguna.id

# Rate limit per IP per menit. Kosongkan di produksi (default 5 login, 3 register); development default 60 dan 30.
# LOGIN_RATE_PER_MIN=
# REGISTER_RATE_PER_MIN=

# Kurir (GoSend, Grab, SPX, Lalamove) dan pembayaran non-tunai (QRIS, GoPay, OVO, DANA) masih TIRUAN sampai kemitraan
# terhubung. dummy = ongkir dari rumus tiruan dan pembayaran selalu sukses; off = hanya pickup + tunai.
# Default: development dummy, produksi off. Isi PARTNERS_MODE=dummy di .env VPS untuk menguji dengan app.
# PARTNERS_MODE=dummy

# Toko baru berstatus pending sampai admin menyetujui (POST /admin/merchants/:id/approve). true = langsung approved.
# Hanya untuk VPS uji; produksi biarkan kosong karena persetujuan admin adalah penyaring kelayakan pangan.
# MERCHANT_AUTO_APPROVE=true

# Email kode lupa password. EMAIL_MODE: smtp (kirim sungguhan) | log (cetak ke log server, uji saja) | off (tidak kirim).
# Default: development log; produksi smtp kalau SMTP_HOST terisi, kalau tidak off (lupa password tidak berfungsi).
# EMAIL_MODE=smtp
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="SisaGuna <no-reply@sisaguna.id>"

# Push notification FCM. Isi path file service account Firebase (JSON) untuk menyalakan; kosong = push mati.
# Di compose produksi taruh file di ${SECRETS_HOST_DIR}/fcm.json lalu isi FCM_CREDENTIALS_FILE=/run/secrets/fcm.json
# FCM_CREDENTIALS_FILE=
# FCM_PROJECT_ID=
